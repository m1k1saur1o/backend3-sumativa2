# Copia este archivo como .env (ignorado por git) y completa los valores.
#   cp .env.example .env && chmod 600 .env
# Los valores marcados con (*) deben ser IDENTICOS a los del .env de ../sumativa3-backend3.

# ---------- JWT (validacion en ms-bff) ----------
# (*) Secreto HS256 compartido con auth-service (minimo 32 caracteres). No lo publiques.
JWT_SECRET=
# (*) Issuer emitido por auth-service
JWT_ISSUER=sumativa3-auth-service
# (*) Audiencia del BFF (auth-service la incluye en el claim aud)
BFF_JWT_AUDIENCE=bff-api

# ---------- Auditoria (ms-bff -> producer-service -> Kafka) ----------
# (*) Cliente de servicio de ms-bff en auth-service (grant client_credentials)
AUTH_CLIENT_ID=ms-bff
AUTH_CLIENT_SECRET=
AUDIT_ENABLED=true
AUDIT_QUEUE_CAPACITY=1000

# ---------- Eureka ----------
# (*) Credenciales HTTP Basic de discovery-service
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=

# ---------- MySQL (usado solo por ms-backend) ----------
MYSQL_HOST=host.docker.internal
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=myapp
MYSQL_USER=
MYSQL_PASSWORD=

# ---------- Despliegue ----------
# Replicas de ms-backend balanceadas por ms-bff
MS_BACKEND_REPLICAS=2
# Puerto e interfaz del host donde se publica ms-bff (unico servicio expuesto de este proyecto)
BFF_PORT=18080
BFF_BIND=0.0.0.0
# Red Docker compartida creada por el compose de sumativa3-backend3
SHARED_NETWORK=sumativa-net
LOG_LEVEL_APP=INFO
