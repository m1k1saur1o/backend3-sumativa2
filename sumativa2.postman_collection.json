{
  "info": {
    "name": "Sumativa 2 - Patron BFF (JWT + auditoria Kafka)",
    "description": "ms-bff protegido con JWT de auth-service. Ejecutar primero 'Auth > Login' (guarda {{token}}). Completar username/password con AUTH_USERNAME/AUTH_PASSWORD del .env de sumativa3. Guia completa: sumativa3-backend3/INSTRUCCIONES_POSTMAN.txt",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (obtiene y guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.access_token);",
                  "pm.test('token_type Bearer', () => pm.expect(body.token_type).to.eql('Bearer'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/auth/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
